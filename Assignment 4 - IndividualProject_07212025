from pyspark.sql.functions import col, lit, udf
from pyspark.sql.types import DoubleType
import numpy as np

# Define cosine similarity
def cosine_similarity(a, b):
    a, b = np.array(a), np.array(b)
    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))

# Register as UDF
cosine_udf = udf(cosine_similarity, DoubleType())

def get_top_k_chunks(query, k=3):
    query_embedding = get_embedding(query)  # list
    df = spark.sql("SELECT * FROM simple_rag_embeddings_dbuser2")
    
    # Create a new column by applying the cosine similarity UDF
    df = df.withColumn("score", cosine_udf(col("embedding"), lit(query_embedding)))
    
    # Get top K scored chunks
    top_chunks = df.orderBy(col("score").desc()).limit(k).toPandas()
    return [row["chunk"] for _, row in top_chunks.iterrows()]

import re

def addition(a, b):
    return a + b

def parse_numbers(prompt):
    nums = list(map(int, re.findall(r'\d+', prompt)))
    return nums if len(nums) >= 2 else [0, 0]

def classify_prompt(prompt):
    classification_prompt = f"""Classify this prompt as either 'math' or 'search'.

Prompt: "{prompt}"
Answer:"""
    result = client.chat.completions.create(
        model="gpt-4o",
        messages=[{"role": "user", "content": classification_prompt}]
    )
    return result.choices[0].message.content.strip().lower()

from langchain_core.runnables import RunnableLambda
from langchain.prompts import PromptTemplate

template = PromptTemplate.from_template("""
Use the following context to answer the question:

{context}

Question: {question}
""")

def run_pipeline(prompt):
    task = classify_prompt(prompt)
    
    if "math" in task:
        a, b = parse_numbers(prompt)
        return f"Answer: {addition(a, b)}"
    
    else:
        top_chunks = get_top_k_chunks(prompt)
        context = "\n\n".join(top_chunks)
        final_prompt = template.format(context=context, question=prompt)
        
        answer = client.chat.completions.create(
            model="gpt-4o",
            messages=[{"role": "user", "content": final_prompt}]
        )
        return answer.choices[0].message.content
print(run_pipeline("What is 30 + 543?"))
print(run_pipeline("What shrimps eat"))
print(run_pipeline("What is 101 + 29?"))
