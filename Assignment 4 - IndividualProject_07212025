def extract_and_chunk_pdf(file_path, chunk_size=400):
    reader = PdfReader(file_path)
    text = " ".join(page.extract_text() or "" for page in reader.pages)
    return [text[i:i+chunk_size] for i in range(0, len(text), chunk_size)]

